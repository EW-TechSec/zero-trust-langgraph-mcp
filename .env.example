# LLM provider selection. Two are implemented: "anthropic" (default, needs
# ANTHROPIC_API_KEY and costs a small amount per call) and "ollama" (runs a
# local model for free, needs Ollama running on your machine: see
# https://ollama.com, then `ollama pull llama3.1`).
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Only used when LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Path to the JSON audit log written by the agent
AUDIT_LOG_PATH=audit_log.json
